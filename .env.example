# Database Connections
DATABASE_URL=postgres://postgres:postgres@localhost:5432/settlement?sslmode=disable
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/settlement_test?sslmode=disable

# Server Configuration
HTTP_ADDR=:8080
SEED_DIR=seed
SETTLEMENT_WINDOW_DAYS=2

# Role-Based Access Control Tokens
OPERATOR_TOKEN=test-operator-token
VIEWER_TOKEN=test-viewer-token
OPERATOR_NAME=Alice

# ==============================================================================
# AI / LLM Configuration
# Mode options:
#   fake      : Offline deterministic simulator (no API keys, zero cost, recommended for dev/testing)
#   anthropic : Anthropic Claude Messages API
#   openai    : OpenAI, Google Gemini, Groq, OpenRouter, DeepSeek, or local Ollama
# ==============================================================================
LLM_MODE=fake

# --- Option A: Anthropic Claude ---
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-3-5-sonnet-20241022

# --- Option B: OpenAI ---
OPENAI_API_KEY=
# LLM_MODEL=gpt-4o

# --- Option C: Google Gemini (via OpenAI compatibility endpoint) ---
GEMINI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-1.5-pro

# --- Option D: Local Ollama / vLLM (Zero API Key) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# --- Option E: Groq / OpenRouter ---
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# External Service Mocks
MOCK_BASE_URL=http://localhost:8080/mock
MOCK_ADMIN=1
